# Canonical site URL (no trailing slash)
NEXT_PUBLIC_BASE_URL="https://awunjia.com"

# Cloudflare Turnstile (contact form). Create a widget at https://dash.cloudflare.com/
# Under the widget, add every hostname you use. Cloudflare treats `localhost` and
# `127.0.0.1` separately — if you open http://127.0.0.1:3000 you must allow 127.0.0.1 too.
# Missing hostnames often show 110200; 300* can still appear from extensions, VPN, or browser privacy.
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAA...
# CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Where contact form attachments are written (default: system temp - e.g. /tmp/portfolio-contact-uploads).
# For a persistent folder on your host: CONTACT_UPLOAD_DIR=/data/contact-uploads
# CONTACT_UPLOAD_DIR=

# SMTP settings for contact form delivery
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# For ports 465, 587, and 2525, TLS mode is chosen from the port (465 = implicit TLS, 587/2525 = STARTTLS).
# SMTP_SECURE only applies to other ports.
# SMTP_USER=you@example.com
# SMTP_PASS=app-password-or-smtp-password
# CONTACT_FROM_EMAIL=portfolio@yourdomain.com
# CONTACT_TO_EMAIL=you@example.com
#
# If POST /api/contact returns 502, check server logs for "[api/contact] SMTP sendMail failed".
# Set CONTACT_SMTP_DEBUG=1 to include a short `debug` string in the JSON response (dev only recommended).
# CONTACT_SMTP_DEBUG=1

# GitHub API (Open Source page). Optional but recommended - avoids low unauthenticated rate limits.
# Classic PAT: repo read public only, or fine-grained: "Contents" read on public repos.
# GITHUB_TOKEN=ghp_...
